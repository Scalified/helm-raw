{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Helm Raw Chart Values Schema",
  "description": "Schema for validating values.yaml for the Raw Helm chart.",
  "type": "object",
  "properties": {
    "defaultLabels": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    },
    "templates": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    }
  }
}